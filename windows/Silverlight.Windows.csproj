<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Silverlight</AssemblyName>
    <RootNamespace>Silverlight.Windows</RootNamespace>
    <ApplicationTitle>Silverlight Archives</ApplicationTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.9.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Content Include="google-oauth-client.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../app/src/main/assets/index.html" Link="web/index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../app/src/main/assets/*.css" Link="web/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../app/src/main/assets/*.js" Link="web/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../app/src/main/assets/vendor/**/*" Link="web/vendor/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
